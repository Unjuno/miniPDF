# Dependencies
node_modules/

# Build / bundler
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Rust — ビルド成果物のみ無視（アプリでは Cargo.lock はコミットする）
target/
src-tauri/target/
# CARGO_TARGET_DIR などで target と別名になったビルド樹
src-tauri/target-*/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Coverage / cache
coverage/
*.lcov
.cache/
*.tmp
*.temp

# Playwright / MCP 作業用（コミット不要）
.playwright-mcp
**/.playwright-mcp/**
playwright-report/
test-results/

# 誤ってコミットしがちなスクショ・一時画像
image.png
screenshot*.png
Screen*.png
/page-*.png
/out-page-*.png
/katex-*.png
/tmp_pdf_pages/

# テスト用生成物（README など追跡したいものは ! で除外）
test_data/*.pdf
test_data/*.png
test_data/*.jpg
test_data/*.jpeg
!test_data/README.md

# ローカル PDF（必要ならファイル名を足す）
mian.pdf

# 個人メモ（誤字ファイル名のままローカル専用）
reviw.md

# 広すぎる *.pdf / *.exe は使わない（fixtures の PDF をコミットできるようにする）
