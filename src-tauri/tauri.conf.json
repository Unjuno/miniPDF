{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miniPDF",
  "version": "1.0.0",
  "identifier": "com.unjuno.minipdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "miniPDF",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Markdown を PDF ライブプレビューする軽量デスクトップアプリ",
    "longDescription": "Markdown を書きながら PDF をプレビューし、必要に応じて PDF として保存します。",
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
